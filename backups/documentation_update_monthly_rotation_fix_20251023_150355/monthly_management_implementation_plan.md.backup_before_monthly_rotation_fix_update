);

CREATE INDEX ix_project_status_history_project ON project_status_history(project_id);
CREATE INDEX ix_project_status_history_changed_at ON project_status_history(changed_at);
CREATE INDEX ix_project_status_history_new_status ON project_status_history(new_status);
```

#### DDL (SQLite - ローカル)
```sql
