<template>
  <div class="monthly-tabs bg-white rounded-t-lg shadow">
    <div class="flex border-b border-gray-200 overflow-x-auto">
      <button 
        v-for="tab in tabs" 
        :key="tab.id"
        @click="selectTab(tab.id)"
        :class="[
          'px-6 py-3 font-medium transition-colors whitespace-nowrap',
          currentTab === tab.id 
            ? 'border-b-2 border-pink-500 text-pink-600 bg-pink-50' 
            : 'text-gray-500 hover:text-gray-700 hover:bg-gray-50'
        ]"
      >
        <component :is="tab.icon" class="w-5 h-5 inline mr-2" />
        {{ tab.label }}
      </button>
    </div>
  </div>
</template>

<script setup>
import { ref, computed, onMounted, onUnmounted, watch } from 'vue'
import { ChartBarIcon, CalendarIcon } from '@heroicons/vue/24/outline'
import { useMonthlyRotationStore } from '../stores/monthlyRotation.js'

const props = defineProps({
  modelValue: {
    type: String,
    default: 'overview'
  }
})

const emit = defineEmits(['update:modelValue'])

// 月次切り替えストアの取得
const rotationStore = useMonthlyRotationStore()

const currentTab = computed({
  get: () => props.modelValue,
  set: (value) => emit('update:modelValue', value)
})

// 月次切り替え状態を監視するリアクティブなタブ生成
const generateDynamicTabs = () => {
  const now = new Date()
  const currentYear = now.getFullYear()
  const currentMonth = now.getMonth() + 1 // 0-basedなので+1
  
  // 月次切り替え状態を監視
  const rotationState = rotationStore.rotationState
  const lastRotationCheck = rotationStore.lastRotationCheck
  
  console.log('タブ生成 - 月次切り替え状態:', {
    rotationState,
    lastRotationCheck,
    currentMonth,
    currentYear
  })
  
  const tabs = [
    { id: 'overview', label: '概要', icon: ChartBarIcon }
  ]
  
  // 過去3ヶ月を動的生成
  for (let i = 2; i >= 0; i--) {
    const targetDate = new Date(currentYear, currentMonth - 1 - i, 1)
    const year = targetDate.getFullYear()
    const month = targetDate.getMonth() + 1
    
    const monthId = `${year}-${month.toString().padStart(2, '0')}`
    const monthLabel = `${month}月`
    
    tabs.push({
      id: monthId,
      label: monthLabel,
      icon: CalendarIcon
    })
  }
  
  return tabs
}

// タブ再生成の強制フラグ
const forceRegeneration = ref(0)

// 月次切り替え状態を監視するリアクティブなタブ生成
const tabs = computed(() => {
  // 月次切り替え状態を監視
  const rotationState = rotationStore.rotationState
  const lastRotationCheck = rotationStore.lastRotationCheck
  
  // forceRegeneration を参照してタブを再生成
  forceRegeneration.value
  
  console.log('タブ再生成 - 月次切り替え状態監視:', {
    rotationState,
    lastRotationCheck,
    forceRegeneration: forceRegeneration.value
  })
  
  return generateDynamicTabs()
})

const selectTab = (tabId) => {
  currentTab.value = tabId
}

// タブ再生成関数（新規追加）
const regenerateTabs = () => {
  console.log('タブ再生成を実行します。')
  forceRegeneration.value++
}

// 月次切り替えイベントの監視（新規追加）
const handleMonthlyRotation = (event) => {
  console.log('月次切り替えイベントを受信:', event.detail)
  regenerateTabs()
}

// 月次切り替え状態の監視（新規追加）
watch(() => rotationStore.rotationState, (newState, oldState) => {
  console.log('月次切り替え状態変更を検知:', { newState, oldState })
  if (newState === 'completed' && oldState === 'running') {
    console.log('月次切り替え完了を検知 - タブ再生成を実行')
    regenerateTabs()
  }
})

// 月次切り替えチェック時刻の監視（新規追加）
watch(() => rotationStore.lastRotationCheck, (newValue, oldValue) => {
  console.log('月次切り替えチェック時刻変更を検知:', { newValue, oldValue })
  if (newValue !== oldValue) {
    console.log('月次切り替えチェック時刻更新 - タブ再生成を実行')
    regenerateTabs()
  }
})

// ライフサイクル管理（新規追加）
onMounted(() => {
  window.addEventListener('monthly-rotation-completed', handleMonthlyRotation)
  console.log('月次切り替え監視を開始しました。')
})

onUnmounted(() => {
  window.removeEventListener('monthly-rotation-completed', handleMonthlyRotation)
  console.log('月次切り替え監視を停止しました。')
})
</script>

