\#\#\# Step 2-1: 新規APIエンドポイントの実装

\#\#\#\# 🎯 目的  
計画書v2.0の「API分離戦略」を完全実装

\#\#\#\# 📝 実装内容

\*\*新規ファイル\*\*: \`app/blueprints/monthly\_current.py\`

\`\`\`python  
from flask import Blueprint, jsonify, request  
from flask\_jwt\_extended import jwt\_required, get\_jwt\_identity  
from sqlalchemy import extract, func  
from datetime import datetime, timedelta  
from app.models import (  
    db, User, MonthlyTarget, MonthlySummary,  
    Project, ProjectStatusHistory,  
    Invoice, InvoiceStatusHistory  
)

monthly\_current\_bp \= Blueprint('monthly\_current', \_\_name\_\_)

@monthly\_current\_bp.route('/api/monthly/current', methods=\['GET'\])  
@jwt\_required()  
def get\_current\_monthly\_data():  
    """  
    計画書v2.0準拠: 今月+先月+次月の3ヶ月分を1回で返す  
    目標: レスポンスタイム \< 500ms  
    """  
    user\_id \= get\_jwt\_identity()  
      
    \# 現在日時から3ヶ月分を計算  
    now \= datetime.utcnow()  
    current\_month \= now.replace(day=1, hour=0, minute=0, second=0, microsecond=0)  
    last\_month \= (current\_month \- timedelta(days=1)).replace(day=1)  
    next\_month \= (current\_month \+ timedelta(days=32)).replace(day=1)  
      
    months \= \[last\_month, current\_month, next\_month\]  
      
    \# 並列でデータ取得（高速化）  
    result\_data \= {}  
      
    for month in months:  
        month\_key \= month.strftime('%Y-%m-01')  
          
        \# 目標取得  
        target \= MonthlyTarget.query.filter\_by(  
            user\_id=user\_id,  
            target\_month=month  
        ).first()  
          
        \# 統計取得（事前集計テーブルがあれば使用、なければリアルタイム計算）  
        summary \= MonthlySummary.query.filter\_by(  
            user\_id=user\_id,  
            summary\_month=month  
        ).first()  
          
        if summary:  
            \# ✅ 事前集計テーブルから高速取得（50-200ms）  
            stats \= {  
                'acquired\_projects': summary.acquired\_projects,  
                'completed\_projects': summary.completed\_projects,  
                'sent\_invoices\_count': summary.sent\_invoices\_count,  
                'sent\_invoices\_amount': float(summary.sent\_invoices\_amount),  
                'paid\_invoices\_count': summary.paid\_invoices\_count,  
                'paid\_invoices\_amount': float(summary.paid\_invoices\_amount),  
                'overdue\_invoices\_count': summary.overdue\_invoices\_count,  
                'overdue\_invoices\_amount': float(summary.overdue\_invoices\_amount)  
            }  
        else:  
            \# ❌ 事前集計テーブルがない場合はリアルタイム計算（遅い）  
            stats \= calculate\_monthly\_stats\_realtime(user\_id, month)  
          
        result\_data\[month\_key\] \= {  
            'target': {  
                'projects': target.target\_projects if target else None,  
                'income': target.target\_income if target else None  
            },  
            'stats': stats  
        }  
      
    return jsonify({  
        'success': True,  
        'current\_month': current\_month.strftime('%Y-%m-01'),  
        'data': result\_data  
    })

def calculate\_monthly\_stats\_realtime(user\_id, month):  
    """  
    リアルタイム計算（事前集計テーブルがない場合のフォールバック）  
    ※ 計画書v2.0の正負集計ロジックを厳守  
    """  
    year \= month.year  
    month\_num \= month.month  
      
    \# 獲得案件数（正負集計）  
    acquired\_positive \= db.session.query(  
        func.count(func.distinct(ProjectStatusHistory.project\_id))  
    ).join(Project).filter(  
        Project.user\_id \== user\_id,  
        ProjectStatusHistory.old\_status \== 'proposed',  
        ProjectStatusHistory.new\_status \== 'contracted',  
        extract('year', ProjectStatusHistory.changed\_at) \== year,  
        extract('month', ProjectStatusHistory.changed\_at) \== month\_num  
    ).scalar() or 0  
      
    acquired\_negative \= db.session.query(  
        func.count(func.distinct(ProjectStatusHistory.project\_id))  
    ).join(Project).filter(  
        Project.user\_id \== user\_id,  
        ProjectStatusHistory.old\_status \== 'contracted',  
        ProjectStatusHistory.new\_status \== 'proposed',  
        extract('year', ProjectStatusHistory.changed\_at) \== year,  
        extract('month', ProjectStatusHistory.changed\_at) \== month\_num  
    ).scalar() or 0  
      
    acquired\_projects \= acquired\_positive \- acquired\_negative  
      
    \# 完了案件数（正負集計）  
    completed\_positive \= db.session.query(  
        func.count(func.distinct(ProjectStatusHistory.project\_id))  
    ).join(Project).filter(  
        Project.user\_id \== user\_id,  
        ProjectStatusHistory.old\_status \== 'contracted',  
        ProjectStatusHistory.new\_status \== 'completed',  
        extract('year', ProjectStatusHistory.changed\_at) \== year,  
        extract('month', ProjectStatusHistory.changed\_at) \== month\_num  
    ).scalar() or 0  
      
    completed\_negative \= db.session.query(  
        func.count(func.distinct(ProjectStatusHistory.project\_id))  
    ).join(Project).filter(  
        Project.user\_id \== user\_id,  
        ProjectStatusHistory.old\_status \== 'completed',  
        ProjectStatusHistory.new\_status \== 'contracted',  
        extract('year', ProjectStatusHistory.changed\_at) \== year,  
        extract('month', ProjectStatusHistory.changed\_at) \== month\_num  
    ).scalar() or 0  
      
    completed\_projects \= completed\_positive \- completed\_negative  
      
    \# 送信済み請求書（会計ロジック準拠）  
    sent\_result \= db.session.query(  
        func.count(Invoice.id),  
        func.coalesce(func.sum(Invoice.total\_amount), 0\)  
    ).filter(  
        Invoice.user\_id \== user\_id,  
        Invoice.status \== 'sent',  
        extract('year', Invoice.created\_at) \== year,  
        extract('month', Invoice.created\_at) \== month\_num  
    ).first()  
      
    \# 支払済み請求書  
    paid\_result \= db.session.query(  
        func.count(Invoice.id),  
        func.coalesce(func.sum(Invoice.total\_amount), 0\)  
    ).filter(  
        Invoice.user\_id \== user\_id,  
        Invoice.status \== 'paid',  
        Invoice.payment\_date.isnot(None),  
        extract('year', Invoice.payment\_date) \== year,  
        extract('month', Invoice.payment\_date) \== month\_num  
    ).first()  
      
    return {  
        'acquired\_projects': acquired\_projects,  
        'completed\_projects': completed\_projects,  
        'sent\_invoices\_count': sent\_result\[0\],  
        'sent\_invoices\_amount': float(sent\_result\[1\]),  
        'paid\_invoices\_count': paid\_result\[0\],  
        'paid\_invoices\_amount': float(paid\_result\[1\]),  
        'overdue\_invoices\_count': 0,  \# TODO: 実装  
        'overdue\_invoices\_amount': 0.0  
    }  
\`\`\`

