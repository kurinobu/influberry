\`\`\`python  
from app.models import db, MonthlySummary  
from datetime import datetime  
from sqlalchemy import extract, func

def update\_monthly\_summary(user\_id, changed\_month):  
    """  
    月次サマリーを再計算・更新  
    ステータス変更時に呼び出される  
    """  
    from app.models import Project, ProjectStatusHistory, Invoice, InvoiceStatusHistory  
      
    year \= changed\_month.year  
    month \= changed\_month.month  
      
    \# 正負集計（計画書v2.0準拠）  
    acquired \= \_calculate\_acquired\_projects(user\_id, year, month)  
    completed \= \_calculate\_completed\_projects(user\_id, year, month)  
    sent\_count, sent\_amount \= \_calculate\_sent\_invoices(user\_id, year, month)  
    paid\_count, paid\_amount \= \_calculate\_paid\_invoices(user\_id, year, month)  
      
    \# UPSERT  
    summary \= MonthlySummary.query.filter\_by(  
        user\_id=user\_id,  
        summary\_month=changed\_month  
    ).first()  
      
    if summary:  
        summary.acquired\_projects \= acquired  
        summary.completed\_projects \= completed  
        summary.sent\_invoices\_count \= sent\_count  
        summary.sent\_invoices\_amount \= sent\_amount  
        summary.paid\_invoices\_count \= paid\_count  
        summary.paid\_invoices\_amount \= paid\_amount  
        summary.last\_updated\_at \= datetime.utcnow()  
    else:  
        summary \= MonthlySummary(  
            user\_id=user\_id,  
            summary\_month=changed\_month,  
            acquired\_projects=acquired,  
            completed\_projects=completed,  
            sent\_invoices\_count=sent\_count,  
            sent\_invoices\_amount=sent\_amount,  
            paid\_invoices\_count=paid\_count,  
            paid\_invoices\_amount=paid\_amount  
        )  
        db.session.add(summary)  
      
    db.session.commit()  
    print(f"✅ 月次サマリー更新完了: {user\_id} \- {changed\_month}")

def \_calculate\_acquired\_projects(user\_id, year, month):  
    """獲得案件数の正負集計"""  
    from app.models import Project, ProjectStatusHistory  
      
    positive \= db.session.query(  
        func.count(func.distinct(ProjectStatusHistory.project\_id))  
    ).join(Project).filter(  
        Project.user\_id \== user\_id,  
        ProjectStatusHistory.old\_status \== 'proposed',  
        ProjectStatusHistory.new\_status \== 'contracted',  
        extract('year', ProjectStatusHistory.changed\_at) \== year,  
        extract('month', ProjectStatusHistory.changed\_at) \== month  
    ).scalar() or 0  
      
    negative \= db.session.query(  
        func.count(func.distinct(ProjectStatusHistory.project\_id))  
    ).join(Project).filter(  
        Project.user\_id \== user\_id,  
        ProjectStatusHistory.old\_status \== 'contracted',  
        ProjectStatusHistory.new\_status \== 'proposed',  
        extract('year', ProjectStatusHistory.changed\_at) \== year,  
        extract('month', ProjectStatusHistory.changed\_at) \== month  
    ).scalar() or 0  
      
    return positive \- negative

def \_calculate\_completed\_projects(user\_id, year, month):  
    """完了案件数の正負集計"""  
    from app.models import Project, ProjectStatusHistory  
      
    positive \= db.session.query(  
        func.count(func.distinct(ProjectStatusHistory.project\_id))  
    ).join(Project).filter(  
        Project.user\_id \== user\_id,  
        ProjectStatusHistory.old\_status \== 'contracted',  
        ProjectStatusHistory.new\_status \== 'completed',  
        extract('year', ProjectStatusHistory.changed\_at) \== year,  
        extract('month', ProjectStatusHistory.changed\_at) \== month  
    ).scalar() or 0  
      
    negative \= db.session.query(  
        func.count(func.distinct(ProjectStatusHistory.project\_id))  
    ).join(Project).filter(  
        Project.user\_id \== user\_id,  
        ProjectStatusHistory.old\_status \== 'completed',  
        ProjectStatusHistory.new\_status \== 'contracted',  
        extract('year', ProjectStatusHistory.changed\_at) \== year,  
        extract('month', ProjectStatusHistory.changed\_at) \== month  
    ).scalar() or 0  
      
    return positive \- negative

def \_calculate\_sent\_invoices(user\_id, year, month):  
    """送信済み請求書の集計（会計ロジック準拠）"""  
    from app.models import Invoice  
      
    result \= db.session.query(  
        func.count(Invoice.id),  
        func.coalesce(func.sum(Invoice.total\_amount), 0\)  
    ).filter(  
        Invoice.user\_id \== user\_id,  
        Invoice.status \== 'sent',  
        extract('year', Invoice.created\_at) \== year,  
        extract('month', Invoice.created\_at) \== month  
    ).first()  
      
    return result\[0\], float(result\[1\])

def \_calculate\_paid\_invoices(user\_id, year, month):  
    """支払済み請求書の集計"""  
    from app.models import Invoice  
      
    result \= db.session.query(  
        func.count(Invoice.id),  
        func.coalesce(func.sum(Invoice.total\_amount), 0\)  
    ).filter(  
        Invoice.user\_id \== user\_id,  
        Invoice.status \== 'paid',  
        Invoice.payment\_date.isnot(None),  
        extract('year', Invoice.payment\_date) \== year,  
        extract('month', Invoice.payment\_date) \== month  
    ).first()  
      
    return result\[0\], float(result\[1\])  
