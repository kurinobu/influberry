\`\`\`javascript  
import { defineStore } from 'pinia'  
import { ref, computed } from 'vue'  
import axios from 'axios'

export const useMonthlyStore \= defineStore('monthly', () \=\> {  
  // State  
  const targets \= ref({})  
  const stats \= ref({})  
  const loading \= ref(false)  
  const error \= ref(null)  
    
  // 重複呼び出し防止用のキャッシュ管理  
  const fetchingTargets \= ref(false)  
  const fetchingStats \= ref(false)  
  const lastFetchTime \= ref({  
    targets: null,  
    stats: null  
  })  
    
  // キャッシュ有効期限（5分）  
  const CACHE\_DURATION \= 5 \* 60 \* 1000  
    
  // ✅ 重複防止機能付きの目標取得  
  async function fetchTargets(year, months) {  
    // 既に取得中なら待つ  
    if (fetchingTargets.value) {  
      console.log('🔧 目標取得: 既に実行中のためスキップ')  
      return  
    }  
      
    // キャッシュが有効なら再取得しない  
    const cacheKey \= \`${year}-${months.join(',')}\`  
    if (lastFetchTime.value.targets &&   
        Date.now() \- lastFetchTime.value.targets \< CACHE\_DURATION &&  
        targets.value\[cacheKey\]) {  
      console.log('🔧 目標取得: キャッシュを使用')  
      return  
    }  
      
    fetchingTargets.value \= true  
    console.log('🔧 月次目標取得開始:', { year, months })  
      
    try {  
      const response \= await axios.get('/api/monthly-targets/', {  
        params: { year, months: months.join(',') }  
      })  
        
      targets.value\[cacheKey\] \= response.data  
      lastFetchTime.value.targets \= Date.now()  
      console.log('🔧 月次目標取得完了')  
    } catch (err) {  
      error.value \= err.message  
      console.error('❌ 月次目標取得失敗:', err)  
    } finally {  
      fetchingTargets.value \= false  
    }  
  }  
    
  // ✅ 重複防止機能付きの統計取得  
  async function fetchStats(year, month) {  
    if (fetchingStats.value) {  
      console.log('🔧 統計取得: 既に実行中のためスキップ')  
      return  
    }  
      
    const cacheKey \= \`${year}-${month}\`  
    if (lastFetchTime.value.stats &&   
        Date.now() \- lastFetchTime.value.stats \< CACHE\_DURATION &&  
        stats.value\[cacheKey\]) {  
      console.log('🔧 統計取得: キャッシュを使用')  
      return  
    }  
      
    fetchingStats.value \= true  
    console.log('🔧 月次統計取得開始:', { year, month })  
      
    try {  
      const response \= await axios.get(\`/api/monthly-stats/${year}/${month}\`)  
        
      stats.value\[cacheKey\] \= response.data  
      lastFetchTime.value.stats \= Date.now()  
      console.log('🔧 月次統計取得完了')  
    } catch (err) {  
      error.value \= err.message  
      console.error('❌ 月次統計取得失敗:', err)  
    } finally {  
      fetchingStats.value \= false  
    }  
  }  
    
  // ✅ キャッシュクリア（ステータス変更時に呼び出す）  
  function clearCache() {  
    lastFetchTime.value.targets \= null  
    lastFetchTime.value.stats \= null  
    console.log('🔧 キャッシュをクリアしました')  
  }  
    
  return {  
    targets,  
    stats,  
    loading,  
    error,  
    fetchTargets,  
    fetchStats,  
    clearCache  
  }  
})  
\`\`\`

