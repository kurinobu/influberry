import axios from 'axios'

export const useMonthlyStore \= defineStore('monthly', () \=\> {  
  // ✅ フラグ管理で段階的切り替え  
  const USE\_NEW\_API \= true  // false で即座に旧APIに戻せる  
    
  // State  
  const currentDate \= ref(new Date())  
  const monthlyData \= ref({})  // { '2025-10-01': { target: {...}, stats: {...} } }  
  const loading \= ref(false)  
  const error \= ref(null)  
    
  // Computed  
  const displayMonths \= computed(() \=\> {  
    const now \= currentDate.value  
    const lastMonth \= new Date(now.getFullYear(), now.getMonth() \- 1, 1\)  
    const thisMonth \= new Date(now.getFullYear(), now.getMonth(), 1\)  
    const nextMonth \= new Date(now.getFullYear(), now.getMonth() \+ 1, 1\)  
      
    return \[  
      { id: formatMonth(lastMonth), label: getMonthLabel(lastMonth) },  
      { id: formatMonth(thisMonth), label: getMonthLabel(thisMonth) },  
      { id: formatMonth(nextMonth), label: getMonthLabel(nextMonth) }  
    \]  
  })  
    
  const defaultTab \= computed(() \=\> {  
    const now \= currentDate.value  
    return formatMonth(new Date(now.getFullYear(), now.getMonth(), 1))  
  })  
    
  // ✅ 新API: 統合取得（計画書v2.0準拠）  
  async function fetchCurrentMonthlyData() {  
    if (USE\_NEW\_API) {  
      loading.value \= true  
      error.value \= null  
        
      try {  
        console.log('🔧 新API使用: /api/monthly/current')  
        const response \= await axios.get('/api/monthly/current')  
          
        // データを格納  
        monthlyData.value \= response.data.data  
          
        console.log('✅ 月次データ取得完了（新API）')  
      } catch (err) {  
        console.warn('⚠️ 新APIが失敗、旧APIにフォールバック')  
        error.value \= err.message  
          
        // フォールバック: 旧APIを使用  
        await fetchMonthlyDataLegacy()  
      } finally {  
        loading.value \= false  
      }  
    } else {  
      // 旧APIを使用（後方互換性）  
      console.log('🔧 旧API使用（フラグ=false）')  
      await fetchMonthlyDataLegacy()  
    }  
  }  
    
  // ❌ 旧API: 個別取得（フォールバック用に保持）  
  async function fetchMonthlyDataLegacy() {  
    loading.value \= true  
    error.value \= null  
      
    try {  
      const now \= currentDate.value  
      const months \= \[  
        now.getMonth(),      // 今月  
        now.getMonth() \- 1,  // 先月  
        now.getMonth() \+ 1   // 来月  
      \]  
        
      console.log('🔧 旧API: 個別取得開始')  
        
      // 目標取得  
      const targetsRes \= await axios.get('/api/monthly-targets/', {  
        params: {  
          year: now.getFullYear(),  
          months: months.join(',')  
        }  
      })  
        
      // 統計取得（各月ごと）  
      for (const month of months) {  
        const statsRes \= await axios.get(  
          \`/api/monthly-stats/${now.getFullYear()}/${month \+ 1}\`  
        )  
          
        const monthKey \= formatMonth(new Date(now.getFullYear(), month, 1))  
        monthlyData.value\[monthKey\] \= {  
          target: targetsRes.data\[monthKey\] || {},  
          stats: statsRes.data || {}  
        }  
      }  
        
      console.log('✅ 月次データ取得完了（旧API）')  
    } catch (err) {  
      error.value \= err.message  
      console.error('❌ 旧API取得失敗:', err)  
    } finally {  
      loading.value \= false  
    }  
  }  
    
  // ✅ 目標設定保存  
  async function saveTarget(targetMonth, data) {  
    try {  
      const response \= await axios.post('/api/monthly-targets', {  
        target\_month: targetMonth,  
        ...data  
      })  
        
      // 保存後、即座に再取得  
      await fetchCurrentMonthlyData()  
        
      return { success: true }  
    } catch (err) {  
      return { success: false, error: err.message }  
    }  
  }  
    
  // ✅ キャッシュクリア（ステータス変更時）  
  async function refreshMonthlyData() {  
    await fetchCurrentMonthlyData()  
  }  
    
  // Utility  
  function formatMonth(date) {  
    return \`${date.getFullYear()}-${String(date.getMonth() \+ 1).padStart(2, '0')}-01\`  
  }  
    
  function getMonthLabel(date) {  
    return \`${date.getMonth() \+ 1}月\`  
  }  
    
  // 日付自動更新  
  setInterval(() \=\> {  
    const now \= new Date()  
    if (now.getDate() \!== currentDate.value.getDate()) {  
      currentDate.value \= now  
      fetchCurrentMonthlyData()  
    }  
  }, 60000\)  
    
  return {  
    currentDate,  
    monthlyData,  
    loading,  
    error,  
    displayMonths,  
    defaultTab,  
    fetchCurrentMonthlyData,  
    saveTarget,  
    refreshMonthlyData  
  }  
})  
\`\`\`

